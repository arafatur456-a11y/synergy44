# ─────────────────────────────────────────────────────────────────────────────
#  Synergy 44 — environment variables
#  Copy to `.env.local` for local development, and add the same keys in
#  Vercel → Project → Settings → Environment Variables for production.
#  Never commit real values. Only variables prefixed NEXT_PUBLIC_ reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── WooCommerce store (required for live products, cart pricing and checkout) ──
# Public base URL of the WordPress/WooCommerce site. Must be https:// in production.
NEXT_PUBLIC_WC_STORE_URL=https://synergy44.com

# REST API key: WordPress → WooCommerce → Settings → Advanced → REST API → Add key
#   Permissions: Read/Write  (Read for the catalog, Write to create orders)
#   Server-only — never prefix these with NEXT_PUBLIC_.
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jewelry detection: products in this category (slug, or the name "Jewelry") — including its
# sub-categories — OR whose SKU starts with the prefix are shown in the glass jewelry gallery.
WC_JEWELRY_CATEGORY=jewelry
WC_JEWELRY_SKU_PREFIX=J-

# ── Instant catalog updates (optional, recommended) ──
# WooCommerce → Settings → Advanced → Webhooks: Product created/updated/deleted
#   Delivery URL: https://<your-site>/api/revalidate   Secret: same value as below
WC_WEBHOOK_SECRET=

# ── Shipping line added to online orders (optional) ──
# The REST API doesn't run shipping-zone calculation, so define the charge here.
# method_id must match a method in WooCommerce → Settings → Shipping (e.g. flat_rate).
WC_SHIPPING_METHOD_ID=
WC_SHIPPING_METHOD_TITLE=Standard shipping
WC_SHIPPING_TOTAL=
WC_FREE_SHIPPING_MIN=

# ── Contact form email delivery via https://resend.com (optional) ──
# If unset, inquiries are logged server-side only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# (also used for booking-request emails)

# ── AI Beauty & Jewelry Concierge (optional) ──
# Server-side Anthropic API key (console.anthropic.com). Without it the concierge still works,
# answering with rule-based recommendations from the catalog.
ANTHROPIC_API_KEY=

# ── Haircut package booking (optional) ──
# JSON POST of each booking request to your booking system / Zapier / Make hook.
# Requests are also emailed via Resend when configured; with neither they're logged server-side.
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=

# ── Newsletter (optional — configure one or both) ──
# Resend audience (uses RESEND_API_KEY above):
RESEND_AUDIENCE_ID=
# Or forward sign-ups as JSON (Mailchimp/Klaviyo via Zapier, WordPress endpoint, CRM…):
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=
