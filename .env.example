# Contact form email delivery (https://resend.com). If unset, inquiries are logged server-side only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Synergy 44 <hello@synergy44.com>"
CONTACT_FROM_EMAIL=

# Optional: direct checkout URL for the bag (e.g. https://synergy44.com/checkout)
NEXT_PUBLIC_CHECKOUT_URL=

# Live WooCommerce catalog (optional — mock data in lib/data.ts is used when unset)
WC_STORE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_JEWELRY_CATEGORY=dichroic-glass-jewelry
